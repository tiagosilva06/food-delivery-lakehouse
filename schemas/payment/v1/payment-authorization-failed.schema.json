{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/payment/v1/payment-authorization-failed.schema.json",
  "title": "PaymentAuthorizationFailed",
  "description": "Contract for the event emitted when payment authorization fails.",
  "allOf": [
    {
      "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/payments" },
        "type": { "const": "com.fooddelivery.payment.authorization-failed.v1" },
        "subject": {
          "type": "string",
          "pattern": "^payments/[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "dataschema": {
          "const": "https://food-delivery-lakehouse.local/schemas/payment/v1/payment-authorization-failed.schema.json"
        },
        "aggregatetype": { "const": "payment" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/paymentAuthorizationFailedData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "paymentAuthorizationFailedData": {
      "type": "object",
      "required": ["failure_code", "retryable"],
      "properties": {
        "failure_code": {
          "enum": [
            "INSUFFICIENT_FUNDS",
            "CARD_DECLINED",
            "EXPIRED_CARD",
            "SUSPECTED_FRAUD",
            "PROVIDER_UNAVAILABLE"
          ]
        },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
