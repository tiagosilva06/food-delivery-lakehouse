{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/payment/v1/payment-refund-failed.schema.json",
  "title": "PaymentRefundFailed",
  "description": "Contract for the event emitted when a payment refund fails.",
  "allOf": [
    {
      "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/payments" },
        "type": { "const": "com.fooddelivery.payment.refund-failed.v1" },
        "subject": {
          "type": "string",
          "pattern": "^payments/[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "dataschema": {
          "const": "https://food-delivery-lakehouse.local/schemas/payment/v1/payment-refund-failed.schema.json"
        },
        "aggregatetype": { "const": "payment" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/paymentRefundFailedData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "paymentRefundFailedData": {
      "type": "object",
      "required": ["refund_id", "failure_code", "retryable"],
      "properties": {
        "refund_id": { "$ref": "#/$defs/identifier" },
        "failure_code": {
          "enum": ["PROVIDER_UNAVAILABLE", "REFUND_REJECTED", "INVALID_TRANSACTION"]
        },
        "retryable": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
