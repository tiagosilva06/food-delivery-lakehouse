{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/fulfillment/v1/fulfillment-cancelled.schema.json",
  "title": "FulfillmentCancelled",
  "description": "Contract for the event emitted when restaurant fulfillment is cancelled.",
  "allOf": [
    { "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/fulfillment" },
        "type": { "const": "com.fooddelivery.fulfillment.cancelled.v1" },
        "subject": {
          "type": "string",
          "pattern": "^fulfillments/[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "dataschema": {
          "const": "https://food-delivery-lakehouse.local/schemas/fulfillment/v1/fulfillment-cancelled.schema.json"
        },
        "aggregatetype": { "const": "fulfillment" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/fulfillmentCancelledData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "fulfillmentCancelledData": {
      "type": "object",
      "required": ["reason_code"],
      "properties": {
        "reason_code": { "enum": ["ORDER_CANCELLED", "PAYMENT_FAILED", "SYSTEM_ERROR"] }
      },
      "additionalProperties": false
    }
  }
}
