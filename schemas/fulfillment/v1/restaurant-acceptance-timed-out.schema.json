{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/fulfillment/v1/restaurant-acceptance-timed-out.schema.json",
  "title": "RestaurantAcceptanceTimedOut",
  "description": "Contract for the event emitted when restaurant acceptance times out.",
  "allOf": [
    { "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/fulfillment" },
        "type": { "const": "com.fooddelivery.fulfillment.restaurant-acceptance-timed-out.v1" },
        "subject": {
          "type": "string",
          "pattern": "^fulfillments/[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "dataschema": {
          "const": "https://food-delivery-lakehouse.local/schemas/fulfillment/v1/restaurant-acceptance-timed-out.schema.json"
        },
        "aggregatetype": { "const": "fulfillment" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/restaurantAcceptanceTimedOutData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "restaurantAcceptanceTimedOutData": {
      "type": "object",
      "required": ["timeout_seconds"],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "additionalProperties": false
    }
  }
}
