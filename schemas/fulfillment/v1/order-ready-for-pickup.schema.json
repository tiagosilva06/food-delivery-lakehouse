{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/fulfillment/v1/order-ready-for-pickup.schema.json",
  "title": "OrderReadyForPickup",
  "description": "Contract for the event emitted when an order is ready for courier pickup.",
  "allOf": [
    { "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/fulfillment" },
        "type": { "const": "com.fooddelivery.fulfillment.order-ready-for-pickup.v1" },
        "subject": {
          "type": "string",
          "pattern": "^fulfillments/[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "dataschema": {
          "const": "https://food-delivery-lakehouse.local/schemas/fulfillment/v1/order-ready-for-pickup.schema.json"
        },
        "aggregatetype": { "const": "fulfillment" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/orderReadyForPickupData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "orderReadyForPickupData": {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    }
  }
}
