{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/delivery/v1/order-delivered.schema.json",
  "title": "OrderDelivered",
  "description": "Contract for the event emitted when the order is delivered.",
  "allOf": [
    { "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/deliveries" },
        "type": { "const": "com.fooddelivery.delivery.order-delivered.v1" },
        "subject": { "type": "string", "pattern": "^deliveries/[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "dataschema": { "const": "https://food-delivery-lakehouse.local/schemas/delivery/v1/order-delivered.schema.json" },
        "aggregatetype": { "const": "delivery" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/orderDeliveredData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "orderDeliveredData": {
      "type": "object",
      "required": ["assignment_attempt_id", "courier_id", "confirmation_type"],
      "properties": {
        "assignment_attempt_id": { "$ref": "#/$defs/identifier" },
        "courier_id": { "$ref": "#/$defs/identifier" },
        "confirmation_type": { "enum": ["CUSTOMER_RECEIVED", "LEFT_AT_DOOR"] }
      },
      "additionalProperties": false
    }
  }
}
