{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/delivery/v1/delivery-failed.schema.json",
  "title": "DeliveryFailed",
  "description": "Contract for the event emitted when delivery fails after pickup.",
  "allOf": [
    { "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/deliveries" },
        "type": { "const": "com.fooddelivery.delivery.failed.v1" },
        "subject": { "type": "string", "pattern": "^deliveries/[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "dataschema": { "const": "https://food-delivery-lakehouse.local/schemas/delivery/v1/delivery-failed.schema.json" },
        "aggregatetype": { "const": "delivery" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/deliveryFailedData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "deliveryFailedData": {
      "type": "object",
      "required": ["assignment_attempt_id", "courier_id", "failure_code"],
      "properties": {
        "assignment_attempt_id": { "$ref": "#/$defs/identifier" },
        "courier_id": { "$ref": "#/$defs/identifier" },
        "failure_code": {
          "enum": ["CUSTOMER_UNAVAILABLE", "VEHICLE_BREAKDOWN", "ACCIDENT", "ADDRESS_NOT_FOUND", "PACKAGE_DAMAGED"]
        }
      },
      "additionalProperties": false
    }
  }
}
