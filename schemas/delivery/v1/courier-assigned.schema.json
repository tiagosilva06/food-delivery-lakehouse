{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/delivery/v1/courier-assigned.schema.json",
  "title": "CourierAssigned",
  "description": "Contract for the event emitted when a courier is assigned to a delivery.",
  "allOf": [
    { "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/deliveries" },
        "type": { "const": "com.fooddelivery.delivery.courier-assigned.v1" },
        "subject": { "type": "string", "pattern": "^deliveries/[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "dataschema": { "const": "https://food-delivery-lakehouse.local/schemas/delivery/v1/courier-assigned.schema.json" },
        "aggregatetype": { "const": "delivery" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/courierAssignedData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128 },
    "courierAssignedData": {
      "type": "object",
      "required": ["assignment_attempt_id", "courier_id", "estimated_arrival_at"],
      "properties": {
        "assignment_attempt_id": { "$ref": "#/$defs/identifier" },
        "courier_id": { "$ref": "#/$defs/identifier" },
        "estimated_arrival_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
