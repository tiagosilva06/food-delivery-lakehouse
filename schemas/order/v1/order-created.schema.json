{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/order/v1/order-created.schema.json",
  "title": "OrderCreated",
  "description": "Contract for the event emitted when a customer creates an order.",
  "allOf": [
    {
      "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "source": {
          "const": "/simulator/orders"
        },
        "type": {
          "const": "com.fooddelivery.order.created.v1"
        },
        "subject": {
          "type": "string",
          "pattern": "^orders/[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "dataschema": {
          "const": "https://food-delivery-lakehouse.local/schemas/order/v1/order-created.schema.json"
        },
        "aggregatetype": {
          "const": "order"
        },
        "aggregateversion": {
          "const": 1
        },
        "data": {
          "$ref": "#/$defs/orderCreatedData"
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "moneyAmount": {
      "type": "integer",
      "minimum": 0
    },
    "orderItem": {
      "type": "object",
      "required": [
        "order_item_id",
        "menu_item_id",
        "quantity",
        "unit_price_minor",
        "line_amount_minor"
      ],
      "properties": {
        "order_item_id": {
          "$ref": "#/$defs/identifier"
        },
        "menu_item_id": {
          "$ref": "#/$defs/identifier"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "unit_price_minor": {
          "type": "integer",
          "minimum": 1
        },
        "line_amount_minor": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "deliveryLocation": {
      "type": "object",
      "required": [
        "delivery_zone_id",
        "latitude",
        "longitude"
      ],
      "properties": {
        "delivery_zone_id": {
          "$ref": "#/$defs/identifier"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "orderCreatedData": {
      "type": "object",
      "required": [
        "customer_id",
        "restaurant_id",
        "delivery_location",
        "items",
        "subtotal_amount_minor",
        "delivery_fee_amount_minor",
        "discount_amount_minor",
        "total_amount_minor",
        "currency"
      ],
      "properties": {
        "customer_id": {
          "$ref": "#/$defs/identifier"
        },
        "restaurant_id": {
          "$ref": "#/$defs/identifier"
        },
        "delivery_location": {
          "$ref": "#/$defs/deliveryLocation"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/orderItem"
          }
        },
        "subtotal_amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "delivery_fee_amount_minor": {
          "$ref": "#/$defs/moneyAmount"
        },
        "discount_amount_minor": {
          "$ref": "#/$defs/moneyAmount"
        },
        "total_amount_minor": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "const": "BRL"
        }
      },
      "additionalProperties": false
    }
  }
}
