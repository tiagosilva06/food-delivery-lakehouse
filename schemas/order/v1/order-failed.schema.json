{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://food-delivery-lakehouse.local/schemas/order/v1/order-failed.schema.json",
  "title": "OrderFailed",
  "description": "Contract for the event emitted when an order reaches the failed state.",
  "allOf": [
    {
      "$ref": "https://food-delivery-lakehouse.local/schemas/common/v1/cloud-event.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "source": { "const": "/simulator/orders" },
        "type": { "const": "com.fooddelivery.order.failed.v1" },
        "subject": {
          "type": "string",
          "pattern": "^orders/[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "dataschema": {
          "const": "https://food-delivery-lakehouse.local/schemas/order/v1/order-failed.schema.json"
        },
        "aggregatetype": { "const": "order" },
        "aggregateversion": { "type": "integer", "minimum": 2 },
        "data": { "$ref": "#/$defs/orderFailedData" }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "failureCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 64
    },
    "orderFailedData": {
      "type": "object",
      "required": ["failure_stage", "failure_code"],
      "properties": {
        "failure_stage": {
          "enum": ["PAYMENT", "FULFILLMENT", "DELIVERY", "ORDER"]
        },
        "failure_code": { "$ref": "#/$defs/failureCode" }
      },
      "additionalProperties": false
    }
  }
}
